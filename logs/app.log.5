CREATE TABLE stamping_parts (
	id INTEGER NOT NULL, 
	vehicle_model VARCHAR(50) NOT NULL, 
	version VARCHAR(20) NOT NULL, 
	seq_no INTEGER, 
	part_number VARCHAR(50) NOT NULL, 
	part_name VARCHAR(200), 
	material VARCHAR(50), 
	thickness NUMERIC(10, 4), 
	part_weight NUMERIC(12, 4), 
	sheet_length NUMERIC(10, 2), 
	sheet_width NUMERIC(10, 2), 
	parts_per_sheet INTEGER, 
	sheet_type VARCHAR(50), 
	tonnage NUMERIC(10, 2), 
	die_type VARCHAR(50), 
	process_method VARCHAR(50), 
	automation VARCHAR(20), 
	remark TEXT, 
	sketch_url VARCHAR(500), 
	created_at DATETIME, 
	updated_at DATETIME, 
	PRIMARY KEY (id), 
	CONSTRAINT uix_part_number_unique UNIQUE (part_number)
)


