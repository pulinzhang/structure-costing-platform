# 生产环境（Windows 一键安装 / 云主机 Docker 手工发版）
# Windows：scripts\windows\setup.bat 在缺少 .env 时复制为本文件
# Linux Docker：仓库根目录 bash deploy.sh 在缺少 .env 时复制本文件
# 部署后请立刻修改 PASSWORD_SALT，并按实际访问地址调整 CORS_ORIGINS

APP_ENV=production
HOST=0.0.0.0
PORT=8000

# 时区（Docker 镜像 / compose 也会设 TZ=Asia/Shanghai）
TZ=Asia/Shanghai

# 仅 Windows run_prod.py 使用。Linux Docker 镜像是单进程 uvicorn，改此值无效
# UVICORN_WORKERS=4

IS_DEBUG=False
LOG_LEVEL=WARNING

# 主库 / 辅助库（会话与异步任务）— 请定期备份 data 目录
DATABASE_URL=sqlite:///./data/stamping_costing.db
AUXILIARY_DATABASE_URL=sqlite:///./data/auxiliary.db

# 必改：随机长字符串，勿与开发机相同
PASSWORD_SALT=CHANGE-ME-TO-A-LONG-RANDOM-SECRET

# JSON 数组：浏览器地址栏里的 origin（协议+主机+端口）
# 例：本机 ["http://127.0.0.1:8000"] ；子域名 ["https://stamping.example.com"]
CORS_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000"]

# Docker 发布到宿主机的端口（供 Nginx 反代；compose 读取此变量）
# Nginx 在 Docker 内：proxy_pass http://172.17.0.1:8000（不要写 127.0.0.1）
# STAMPING_PUBLISH_PORT=8000
# ---------------------------------------------------------------------------
# LLM（OpenAI 兼容接口：DeepSeek / 阿里云千问等）
# 仅由 app/services/llm/client/ 读取；禁止写入 costing 业务配置
# ---------------------------------------------------------------------------
# DeepSeek（默认示例）
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com

# 阿里云千问（改用时取消注释并填入密钥，可改为 qwen3.5-plus 等有权限的模型）
# LLM_API_KEY=
# LLM_MODEL=qwen3.5-plus-2026-02-15
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
