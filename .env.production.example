# 生产环境（Windows 服务器 / 内网机）
# 由 scripts\windows\setup.bat 在缺少 .env 时自动复制为项目根目录 .env
# 部署后请立刻修改 PASSWORD_SALT，并按实际访问地址调整 CORS_ORIGINS

APP_ENV=production
HOST=0.0.0.0
PORT=8000

# Uvicorn 工作进程数（CPU 密集/多并发时可 4；SQLite 写多时建议 2～4，勿盲目拉高）
UVICORN_WORKERS=4

DEBUG=False
LOG_LEVEL=WARNING

# 主库 / 辅助库（会话与异步任务）— 请定期备份 data 目录
DATABASE_URL=sqlite:///./data/stamping_costing.db
AUXILIARY_DATABASE_URL=sqlite:///./data/auxiliary.db

# 必改：随机长字符串，勿与开发机相同
PASSWORD_SALT=CHANGE-ME-TO-A-LONG-RANDOM-SECRET

# JSON 数组：浏览器地址栏里的 origin（协议+主机+端口）
# 例：本机 ["http://127.0.0.1:8000"] ；局域网 ["http://10.0.0.8:8000"]
CORS_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000"]
