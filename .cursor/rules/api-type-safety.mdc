## 7.1 HTTP Method Response Rules

Every HTTP method must follow consistent response patterns:

| Method | Purpose | Service Return | Router Return | Response Model |
|--------|---------|----------------|---------------|----------------|
| `GET` (single) | 获取单个资源 | `VO`（不存在则抛 `NotFoundException`） | `ApiResponse.ok(data=vo)` | `ApiResponse[UserVO]` |
| `GET` (list) | 获取资源列表 | `list[VO]` 或 `(list[VO], total[, filters])` | `ApiResponse.ok(data=list)` 或 `ApiResponse.list_(items=...)` | `ApiResponse[list[UserVO]]` 或 `ApiResponse[PageResult[UserVO]]` |
| `POST` | 创建资源 | `VO` | `ApiResponse.created(data=vo)` | `ApiResponse[UserVO]` |
| `POST` | `start_*` 入队（立刻 `task_id`） | `AsyncTaskAcceptedVO` | `ApiResponse.ok(data=accepted)`（HTTP 200，不要 201） | `ApiResponse[AsyncTaskAcceptedVO]` |
| `PUT` / `PATCH` | 更新资源 | `VO`（不存在则抛 `NotFoundException`） | `ApiResponse.updated(data=vo)` | `ApiResponse[UserVO]` |
| `POST` | 批量审核 / 批量删除 | 结果 VO | `ApiResponse.ok(data=result)` | `ApiResponse[…ResultVO]` |
| `DELETE` | 删除资源 | `None`（不存在则抛 `NotFoundException`） | `ApiResponse.deleted(message="删除成功")` | `ApiResponse[None]` |
| `GET` | Excel / 原件下载 | bytes | `StreamingResponse` / `FileResponse` | 无 `ApiResponse` |

### GET - 获取单个资源

```python
@router.get(
    "/users/{user_id}",
    response_model=ApiResponse[UserVO]
)
def get_user(
    user_id: int,
    db: Session = Depends(get_db),
    current_user: UserVO = Depends(require_perm(Perm.SETTINGS_USERS_VIEW)),
) -> ApiResponse[UserVO]:
    service = UserService()
    user = service.get_user(db, user_id)
    return ApiResponse.ok(data=user)
```

### GET - 获取列表（不分页）

```python
@router.get(
    "/users",
    response_model=ApiResponse[list[UserVO]]
)
def list_users(
    db: Session = Depends(get_db),
    current_user: UserVO = Depends(require_perm(Perm.SETTINGS_USERS_VIEW)),
) -> ApiResponse[list[UserVO]]:
    service = UserService()
    users = service.list_users(db)
    return ApiResponse.ok(data=users)
```

### GET - 获取列表（分页）

```python
@router.get(
    "/users",
    response_model=ApiResponse[PageResult[UserVO]]
)
def list_users_paginated(
    page: int = Query(1, ge=1),
    size: int = Query(20, ge=1, le=100),
    db: Session = Depends(get_db),
    current_user: UserVO = Depends(require_perm(Perm.SETTINGS_USERS_VIEW)),
) -> ApiResponse[PageResult[UserVO]]:
    service = UserService()
    users, total = service.list_users_paginated(db, page=page, size=size)
    return ApiResponse.list_(
        items=users,
        total=total,
        page=page,
        page_size=size
    )
```

### POST - 创建资源

```python
@router.post(
    "/users",
    response_model=ApiResponse[UserVO],
    status_code=status.HTTP_201_CREATED
)
def create_user(
    dto: UserCreateDTO,
    db: Session = Depends(get_db),
    current_user: UserVO = Depends(require_perm(Perm.SETTINGS_USERS_CREATE)),
) -> ApiResponse[UserVO]:
    service = UserService()
    user = service.create_user(db, dto, current_user=current_user)
    return ApiResponse.created(data=user, message="创建成功")
```

### POST - `start_*` 入队（HTTP 200，不是 201）

```python
@router.post("/", response_model=ApiResponse[AsyncTaskAcceptedVO])
async def upload_stamping_file(
    ...,
    current_user: UserVO = Depends(require_perm(Perm.STAMPING_UPLOAD_UPLOAD)),
) -> ApiResponse[AsyncTaskAcceptedVO]:
    accepted = service.start_upload(..., current_user=current_user)
    return ApiResponse.ok(data=accepted, message="上传成功，后台开始解析")
```

### PUT - 更新资源

```python
@router.put(
    "/users/{user_id}",
    response_model=ApiResponse[UserVO]
)
def update_user(
    user_id: int,
    dto: UserUpdateDTO,
    db: Session = Depends(get_db),
    current_user: UserVO = Depends(require_perm(Perm.SETTINGS_USERS_UPDATE)),
) -> ApiResponse[UserVO]:
    service = UserService()
    user = service.update_user(db, user_id, dto, current_user=current_user)
    return ApiResponse.updated(data=user, message="更新成功")
```

### DELETE - 删除资源

```python
@router.delete(
    "/users/{user_id}",
    response_model=ApiResponse[None]
)
def delete_user(
    user_id: int,
    db: Session = Depends(get_db),
    current_user: UserVO = Depends(require_perm(Perm.SETTINGS_USERS_DELETE)),
) -> ApiResponse[None]:
    service = UserService()
    service.delete_user(db, user_id)
    return ApiResponse.deleted(message="删除成功")
```

### Error Response Pattern

业务失败由 Service 抛 `NotFoundException` / `BusinessException`（冲突 `code=409`），`business_exception_handler` 写成 `ApiResponse.fail`。Router **不要** `try/except` 再转 `HTTPException`，不要拆 `(record, error)`，不要 `if not vo: 404`。

```python
@router.get("/users/{user_id}", ...)
def get_user(...):
    user = service.get_user(db, user_id)
    return ApiResponse.ok(data=user)
```

请求体 Pydantic 校验走 `validation_exception_handler`（422）。未登录走 `deps/auth` 的 `HTTPException(401)`。未捕获异常走 `generic_exception_handler`（500）。细则见架构宪法 §5.2。

