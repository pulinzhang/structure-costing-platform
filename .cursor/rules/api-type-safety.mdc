## 7.1 HTTP Method Response Rules

Every HTTP method must follow consistent response patterns:

| Method | Purpose | Service Return | Router Return | Response Model |
|--------|---------|----------------|---------------|----------------|
| `GET` (single) | 获取单个资源 | `VO` | `ApiResponse.ok(data=vo)` | `ApiResponse[UserVO]` |
| `GET` (list) | 获取资源列表 | `list[VO]` 或 `PageResult[VO]` | `ApiResponse.ok(data=list)` 或 `ApiResponse.list_(items=...)` | `ApiResponse[list[UserVO]]` 或 `ApiResponse[BasePageResponse[UserVO]]` |
| `POST` | 创建资源 | `VO` | `ApiResponse.created(data=vo)` | `ApiResponse[UserVO]` |
| `PUT` / `PATCH` | 更新资源 | `VO` | `ApiResponse.updated(data=vo)` | `ApiResponse[UserVO]` |
| `DELETE` | 删除资源 | `None` | `ApiResponse.deleted(message="删除成功")` | `ApiResponse[None]` |

### GET - 获取单个资源

```python
@router.get(
    "/users/{user_id}",
    response_model=ApiResponse[UserVO]
)
def get_user(
    user_id: int,
    db: Session = Depends(get_db),
    current_user: UserVO = Depends(require_perm(Perm.SETTINGS_USERS_VIEW)),
) -> ApiResponse[UserVO]:
    service = UserService()
    user = service.get_user(db, user_id)
    if not user:
        raise HTTPException(status_code=404, detail="用户不存在")
    return ApiResponse.ok(data=user)
```

### GET - 获取列表（不分页）

```python
@router.get(
    "/users",
    response_model=ApiResponse[list[UserVO]]
)
def list_users(
    db: Session = Depends(get_db),
    current_user: UserVO = Depends(require_perm(Perm.SETTINGS_USERS_VIEW)),
) -> ApiResponse[list[UserVO]]:
    service = UserService()
    users = service.list_users(db)
    return ApiResponse.ok(data=users)
```

### GET - 获取列表（分页）

```python
@router.get(
    "/users",
    response_model=ApiResponse[BasePageResponse[UserVO]]
)
def list_users_paginated(
    skip: int = Query(0, ge=0),
    limit: int = Query(20, ge=1, le=100),
    db: Session = Depends(get_db),
    current_user: UserVO = Depends(require_perm(Perm.SETTINGS_USERS_VIEW)),
) -> ApiResponse[BasePageResponse[UserVO]]:
    service = UserService()
    users, total = service.list_users_paginated(db, skip=skip, limit=limit)
    return ApiResponse.list_(
        items=users,
        total=total,
        page=(skip // limit) + 1,
        page_size=limit
    )
```

### POST - 创建资源

```python
@router.post(
    "/users",
    response_model=ApiResponse[UserVO],
    status_code=status.HTTP_201_CREATED
)
def create_user(
    dto: UserCreateDTO,
    db: Session = Depends(get_db),
    current_user: UserVO = Depends(require_perm(Perm.SETTINGS_USERS_CREATE)),
) -> ApiResponse[UserVO]:
    service = UserService()
    user = service.create_user(db, dto, current_user=current_user)
    return ApiResponse.created(data=user, message="创建成功")
```

### PUT - 更新资源

```python
@router.put(
    "/users/{user_id}",
    response_model=ApiResponse[UserVO]
)
def update_user(
    user_id: int,
    dto: UserUpdateDTO,
    db: Session = Depends(get_db),
    current_user: UserVO = Depends(require_perm(Perm.SETTINGS_USERS_UPDATE)),
) -> ApiResponse[UserVO]:
    service = UserService()
    user = service.update_user(db, user_id, dto, current_user=current_user)
    if not user:
        raise HTTPException(status_code=404, detail="用户不存在")
    return ApiResponse.updated(data=user, message="更新成功")
```

### DELETE - 删除资源

```python
@router.delete(
    "/users/{user_id}",
    response_model=ApiResponse[None]
)
def delete_user(
    user_id: int,
    db: Session = Depends(get_db),
    current_user: UserVO = Depends(require_perm(Perm.SETTINGS_USERS_DELETE)),
) -> ApiResponse[None]:
    service = UserService()
    service.delete_user(db, user_id)
    return ApiResponse.deleted(message="删除成功")
```

### Error Response Pattern

All endpoints should handle errors consistently:

```python
from fastapi import HTTPException, status

@router.get("/users/{user_id}", ...)
def get_user(...):
    try:
        user = service.get_user(db, user_id)
        if not user:
            raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="用户不存在")
        return ApiResponse.ok(data=user)
    except ValueError as e:
        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=str(e))
```

Note: Use `HTTPException` for error handling. The `detail` will be included in the response `message` field via FastAPI exception handler.

