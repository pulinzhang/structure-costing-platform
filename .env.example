# 应用环境: development, production, test
APP_ENV=development

# 服务器配置，0.0.0.0 表示监听所有网络接口
HOST=0.0.0.0
PORT=8000

# 数据库配置 (使用 SQLite)
DATABASE_URL=sqlite:///./data/stamping_costing.db
# 辅助库：Token 会话、异步任务进度等，与主库隔离
AUXILIARY_DATABASE_URL=sqlite:///./data/auxiliary.db

# 日志配置
LOG_LEVEL=INFO

# 调试模式
IS_DEBUG=True

# ---------------------------------------------------------------------------
# LLM（OpenAI 兼容接口：DeepSeek / 阿里云千问等）
# 仅由 app/services/llm/client/ 读取；禁止写入 costing 业务配置
# ---------------------------------------------------------------------------
# DeepSeek（默认示例）
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com

# 阿里云千问（改用时取消注释并填入密钥，可改为 qwen3.5-plus 等有权限的模型）
# LLM_API_KEY=
# LLM_MODEL=qwen3.5-plus-2026-02-15
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
