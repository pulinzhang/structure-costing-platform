## 七、JavaScript 规范

### 7.1 工具函数

```javascript
// HTML 转义（防止 XSS）
const esc = (value) => {
    if (value == null) return '-';
    return String(value).replace(/[&<>"']/g, (ch) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    }[ch]));
};

// 数字格式化
const fmtNum = (value, digits = 2) => {
    if (value == null || Number.isNaN(value)) return '-';
    return Number(value).toFixed(digits);
};

// Brabus 风格 Toast
const showToast = (message, type = 'success') => {
    const colors = {
        success: 'border-[#2e7d32]',
        error: 'border-[#c62828]',
        warning: 'border-[#f57f17]',
    };
    const icons = {
        success: 'M5 13l4 4L19 7',
        error: 'M6 18L18 6M6 6l12 12',
        warning: 'M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z',
    };
    const iconColor = {
        success: 'text-[#2e7d32]',
        error: 'text-[#c62828]',
        warning: 'text-[#f57f17]',
    };

    const toast = document.createElement('div');
    toast.className = `fixed top-4 right-4 bg-[#1e1e1e] border ${colors[type]} px-4 py-3 rounded shadow-lg z-[9999] animate-fade-in`;
    toast.innerHTML = `
        <div class="flex items-center gap-3">
            <svg class="w-5 h-5 ${iconColor[type]}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="${icons[type]}"></path>
            </svg>
            <span class="text-xs text-[#ffffff]">${esc(message)}</span>
        </div>
    `;
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 3000);
};
```

